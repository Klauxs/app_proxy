{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "erasableSyntaxOnly": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.js", "tests/**/*.ts", "scripts/**/*.ts"]
}
