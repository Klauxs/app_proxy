#!/bin/bash
set -uo pipefail

APP_PROXY_CLI_RESOURCES="__APP_PROXY_CLI_RESOURCES__"

if [[ ! -f "$APP_PROXY_CLI_RESOURCES/app-proxy-cli.sh" ]]; then
  echo "app-proxy resources missing: $APP_PROXY_CLI_RESOURCES" >&2
  echo "Reinstall from the AppProxyInstaller DMG." >&2
  exit 1
fi

. "$APP_PROXY_CLI_RESOURCES/app-proxy-cli.sh"
app_proxy_cli_main "$@"
exit $?
