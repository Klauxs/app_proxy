ObjC.import('Foundation');
ObjC.import('stdlib');

function writeStderr(message) {
  var text = $.NSString.alloc.initWithUTF8String(String(message) + '\n');
  $.NSFileHandle.fileHandleWithStandardError.writeData(text.dataUsingEncoding($.NSUTF8StringEncoding));
}

function writeStdout(message) {
  var text = $.NSString.alloc.initWithUTF8String(String(message) + '\n');
  $.NSFileHandle.fileHandleWithStandardOutput.writeData(text.dataUsingEncoding($.NSUTF8StringEncoding));
}

function fail(message) {
  writeStderr('app-proxy-manifest: ' + message);
  $.exit(1);
}

function readStdin() {
  var data = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
  var text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding);
  return text ? ObjC.unwrap(text) : '';
}

function readTextFile(path) {
  var text = $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, null);
  if (!text || (typeof text.isNil === 'function' && text.isNil())) {
    return null;
  }
  var unwrapped = ObjC.unwrap(text);
  return unwrapped === undefined || unwrapped === null ? null : unwrapped;
}

function writeTextFile(path, content) {
  var nsText = $.NSString.alloc.initWithUTF8String(content);
  var ok = nsText.writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, null);
  if (!ok) {
    throw new Error('unable to write file: ' + path);
  }
}

function emptyManifest() {
  return {
    version: 1,
    next_profile_id: 1,
    settings: {
      doh_server: '',
      upstream_interface: '',
      upstream_interface_mode: 'auto-binding',
      claude_rules_profile: ''
    },
    profiles: []
  };
}

function loadManifest(path) {
  var text = readTextFile(path);
  if (text === null) {
    fail('manifest missing: ' + path);
  }
  var manifest;
  try {
    manifest = JSON.parse(text);
  } catch (error) {
    fail('manifest is not valid JSON: ' + path);
  }
  if (!manifest || typeof manifest !== 'object' || Array.isArray(manifest)) {
    fail('manifest root must be an object');
  }
  if (!Array.isArray(manifest.profiles)) {
    manifest.profiles = [];
  }
  if (!manifest.settings || typeof manifest.settings !== 'object') {
    manifest.settings = emptyManifest().settings;
  }
  return manifest;
}

function saveManifest(path, manifest) {
  writeTextFile(path, JSON.stringify(manifest, null, 2) + '\n');
}

function validatePort(value, fieldName) {
  var stringValue = String(value === undefined || value === null ? '' : value);
  if (!/^[0-9]+$/.test(stringValue)) {
    throw new Error(fieldName + ' must be a decimal integer');
  }
  var port = Number(stringValue);
  if (port < 1 || port > 65535) {
    throw new Error(fieldName + ' must be between 1 and 65535');
  }
  return port;
}

var SOURCE_KINDS = { subscription: true, manual: true, imported: true };
var MANUAL_PROTOCOLS = { http: true, socks5: true };

function findProfile(manifest, id) {
  var i;
  for (i = 0; i < manifest.profiles.length; i++) {
    if (manifest.profiles[i].id === id) {
      return manifest.profiles[i];
    }
  }
  return null;
}

function validateProfileInput(manifest, profile, selfId) {
  if (!profile || typeof profile !== 'object' || Array.isArray(profile)) {
    throw new Error('profile must be an object');
  }
  profile.listen_port = validatePort(profile.listen_port, 'listen_port');
  manifest.profiles.forEach(function (existing) {
    if (existing.id !== selfId && existing.listen_port === profile.listen_port) {
      throw new Error('listen_port ' + profile.listen_port + ' already used by ' + existing.id);
    }
  });
  if (!profile.source || !SOURCE_KINDS[profile.source.kind]) {
    throw new Error('source.kind must be subscription, manual, or imported');
  }
  if (profile.source.kind === 'subscription' && !String(profile.source.url || '').trim()) {
    throw new Error('subscription source requires url');
  }
  if (!Array.isArray(profile.nodes) || profile.nodes.length === 0) {
    throw new Error('profile requires at least one node');
  }
  profile.nodes.forEach(function (node) {
    if (!node || typeof node !== 'object') {
      throw new Error('node must be an object');
    }
    if (!String(node.name || '').trim()) {
      throw new Error('node missing name');
    }
    if (!String(node.protocol || '').trim()) {
      throw new Error('node missing protocol');
    }
    if (MANUAL_PROTOCOLS[node.protocol]) {
      if (!String(node.server || '').trim()) {
        throw new Error('manual node missing server');
      }
      node.server_port = validatePort(node.server_port, 'node server_port');
      if (node.relay_profile) {
        var relay = findProfile(manifest, String(node.relay_profile));
        if (!relay) {
          throw new Error('relay_profile references missing profile: ' + node.relay_profile);
        }
        if (selfId && String(node.relay_profile) === selfId) {
          throw new Error('relay_profile must not reference its own profile');
        }
      }
    }
  });
  var selectedCount = profile.nodes.filter(function (node) { return node.selected; }).length;
  if (selectedCount === 0) {
    throw new Error('profile requires at least one selected node');
  }
  if (profile.gateway_node === null) {
    // patch semantics: {"gateway_node": null} removes the gateway egress
    delete profile.gateway_node;
  }
  if (profile.gateway_node !== undefined) {
    var gateway = profile.gateway_node;
    if (!gateway || typeof gateway !== 'object' || Array.isArray(gateway)) {
      throw new Error('gateway_node must be an object');
    }
    if (!MANUAL_PROTOCOLS[gateway.protocol]) {
      throw new Error('gateway_node protocol must be http or socks5');
    }
    if (!String(gateway.server || '').trim()) {
      throw new Error('gateway_node missing server');
    }
    gateway.server_port = validatePort(gateway.server_port, 'gateway_node server_port');
  }
}

function collectDependents(manifest, id) {
  var relayDependents = [];
  manifest.profiles.forEach(function (profile) {
    if (profile.id === id) {
      return;
    }
    (profile.nodes || []).forEach(function (node) {
      if (String(node.relay_profile || '') === id) {
        relayDependents.push({ profile: profile.id, node: node.name });
      }
    });
  });
  return {
    relay_dependents: relayDependents,
    claude_rules_target: String(manifest.settings.claude_rules_profile || '') === id
  };
}

var CLAUDE_DOMAIN_SUFFIXES = [
  'anthropic.com',
  'clau.de',
  'claude.ai',
  'claudeusercontent.com',
  'claude-api.com',
  'claudecontentmoderation.com',
  'claudemcpclient.com'
];

var CLAUDE_DOMAIN_KEYWORDS = ['anthropic', 'claude'];

function arrayValue(value) {
  if (Array.isArray(value)) return value.map(String);
  if (value === undefined || value === null || value === '') return [];
  return [String(value)];
}

function sameStringSet(left, right) {
  var a = arrayValue(left).sort();
  var b = arrayValue(right).sort();
  if (a.length !== b.length) return false;
  for (var i = 0; i < a.length; i++) {
    if (a[i] !== b[i]) return false;
  }
  return true;
}

function isClaudeManagedRule(rule) {
  if (!rule || typeof rule !== 'object' || Array.isArray(rule)) return false;
  return sameStringSet(rule.domain_suffix, CLAUDE_DOMAIN_SUFFIXES) ||
    sameStringSet(rule.domain_keyword, CLAUDE_DOMAIN_KEYWORDS);
}

var LEGACY_PROTOCOL_BY_TYPE = {
  shadowsocks: 'ss',
  socks: 'socks5'
};

function importLegacyConfig(manifestPath, configPath) {
  var text = readTextFile(configPath);
  if (text === null) {
    fail('legacy config missing: ' + configPath);
  }
  var config;
  try {
    config = JSON.parse(text);
  } catch (error) {
    fail('legacy config is not valid JSON: ' + configPath);
  }

  var inbounds = Array.isArray(config.inbounds) ? config.inbounds : [];
  var outbounds = Array.isArray(config.outbounds) ? config.outbounds : [];
  var rules = config && config.route && Array.isArray(config.route.rules) ? config.route.rules : [];

  var httpInbound = null;
  inbounds.forEach(function (inbound) {
    if (!httpInbound && inbound && inbound.type === 'http' && inbound.listen === '127.0.0.1' && inbound.listen_port !== undefined) {
      httpInbound = inbound;
    }
  });
  if (!httpInbound) {
    fail('legacy config has no local http inbound to import');
  }

  var group = null;
  outbounds.forEach(function (outbound) {
    if (!group && outbound && outbound.type === 'urltest' && Array.isArray(outbound.outbounds) && outbound.outbounds.length > 0) {
      group = outbound;
    }
  });
  if (!group) {
    fail('legacy config has no urltest outbound group to import');
  }

  var outboundByTag = {};
  outbounds.forEach(function (outbound) {
    if (outbound && outbound.tag) {
      outboundByTag[outbound.tag] = outbound;
    }
  });

  var nodes = [];
  group.outbounds.forEach(function (tag) {
    var outbound = outboundByTag[tag];
    if (!outbound) {
      return;
    }
    nodes.push({
      name: String(outbound.tag),
      protocol: LEGACY_PROTOCOL_BY_TYPE[outbound.type] || String(outbound.type),
      server: outbound.server,
      server_port: outbound.server_port,
      selected: true,
      raw_outbound: outbound
    });
  });
  if (!nodes.length) {
    fail('legacy config urltest group references no known outbounds');
  }

  var hasClaudeRules = false;
  var unrecognized = 0;
  rules.forEach(function (rule) {
    if (isClaudeManagedRule(rule)) {
      hasClaudeRules = true;
      return;
    }
    unrecognized += 1;
  });

  var manifest = emptyManifest();
  var profileId = 'pf' + manifest.next_profile_id;
  manifest.next_profile_id += 1;
  manifest.profiles.push({
    id: profileId,
    listen_port: validatePort(httpInbound.listen_port, 'legacy listen_port'),
    source: { kind: 'imported' },
    nodes: nodes
  });
  if (hasClaudeRules) {
    manifest.settings.claude_rules_profile = profileId;
  }
  saveManifest(manifestPath, manifest);

  return {
    profile: profileId,
    listen_port: manifest.profiles[0].listen_port,
    nodes: nodes.length,
    claude_rules: hasClaudeRules,
    unrecognized_rules: unrecognized
  };
}

function run(argv) {
  if (argv.length < 2) {
    fail('usage: app-proxy-manifest.jxa <command> <manifest-path> [args]');
  }
  var command = String(argv[0]);
  var manifestPath = String(argv[1]);

  try {
    if (command === 'init') {
      if (readTextFile(manifestPath) === null) {
        saveManifest(manifestPath, emptyManifest());
      }
      return;
    }

    if (command === 'read') {
      var manifest = loadManifest(manifestPath);
      writeStdout(JSON.stringify(manifest, null, 2));
      return;
    }

    if (command === 'add-profile') {
      var addManifest = loadManifest(manifestPath);
      var input = readStdin();
      var profile;
      try {
        profile = JSON.parse(input);
      } catch (error) {
        fail('profile input is not valid JSON');
      }
      validateProfileInput(addManifest, profile, null);
      profile.id = 'pf' + addManifest.next_profile_id;
      addManifest.next_profile_id += 1;
      addManifest.profiles.push(profile);
      saveManifest(manifestPath, addManifest);
      writeStdout(profile.id);
      return;
    }

    if (command === 'update-profile') {
      if (argv.length < 3) {
        fail('update-profile requires a profile id');
      }
      var updateManifest = loadManifest(manifestPath);
      var updateId = String(argv[2]);
      var existing = findProfile(updateManifest, updateId);
      if (!existing) {
        fail('profile not found: ' + updateId);
      }
      var patchInput = readStdin();
      var patch;
      try {
        patch = JSON.parse(patchInput);
      } catch (error) {
        fail('profile patch is not valid JSON');
      }
      Object.keys(patch).forEach(function (key) {
        if (key === 'id') {
          return;
        }
        existing[key] = patch[key];
      });
      validateProfileInput(updateManifest, existing, updateId);
      saveManifest(manifestPath, updateManifest);
      return;
    }

    if (command === 'get-profile') {
      if (argv.length < 3) {
        fail('get-profile requires a profile id');
      }
      var getManifest = loadManifest(manifestPath);
      var found = findProfile(getManifest, String(argv[2]));
      if (!found) {
        fail('profile not found: ' + argv[2]);
      }
      writeStdout(JSON.stringify(found, null, 2));
      return;
    }

    if (command === 'remove-profile') {
      if (argv.length < 3) {
        fail('remove-profile requires a profile id');
      }
      var removeManifest = loadManifest(manifestPath);
      var removeId = String(argv[2]);
      if (!findProfile(removeManifest, removeId)) {
        fail('profile not found: ' + removeId);
      }
      var deps = collectDependents(removeManifest, removeId);
      if (deps.relay_dependents.length > 0 || deps.claude_rules_target) {
        fail('profile ' + removeId + ' has dependents: ' + JSON.stringify(deps));
      }
      removeManifest.profiles = removeManifest.profiles.filter(function (profile) {
        return profile.id !== removeId;
      });
      saveManifest(manifestPath, removeManifest);
      return;
    }

    if (command === 'set-setting') {
      if (argv.length < 3) {
        fail('set-setting requires a key');
      }
      var settingManifest = loadManifest(manifestPath);
      var key = String(argv[2]);
      var value = argv.length > 3 ? String(argv[3]) : '';
      if (key === 'claude_rules_profile' && value !== '' && !findProfile(settingManifest, value)) {
        fail('claude_rules_profile references missing profile: ' + value);
      }
      settingManifest.settings[key] = value;
      saveManifest(manifestPath, settingManifest);
      return;
    }

    if (command === 'dependents') {
      if (argv.length < 3) {
        fail('dependents requires a profile id');
      }
      var depsManifest = loadManifest(manifestPath);
      var depsId = String(argv[2]);
      if (!findProfile(depsManifest, depsId)) {
        fail('profile not found: ' + depsId);
      }
      writeStdout(JSON.stringify(collectDependents(depsManifest, depsId), null, 2));
      return;
    }

    if (command === 'align-subscription') {
      if (argv.length < 3) {
        fail('align-subscription requires a profile id');
      }
      var alignManifest = loadManifest(manifestPath);
      var alignId = String(argv[2]);
      var alignProfile = findProfile(alignManifest, alignId);
      if (!alignProfile) {
        fail('profile not found: ' + alignId);
      }
      if (!alignProfile.source || alignProfile.source.kind !== 'subscription') {
        fail('profile ' + alignId + ' is not subscription-backed; update is unavailable');
      }
      var alignInput;
      try {
        alignInput = JSON.parse(readStdin());
      } catch (error) {
        fail('parsed subscription input is not valid JSON');
      }
      var incoming = (Array.isArray(alignInput.nodes) ? alignInput.nodes : []).filter(function (node) {
        return node && node.status === 'supported' && String(node.name || '').trim();
      });
      if (!incoming.length) {
        fail('parsed subscription contains no supported nodes');
      }

      var oldByName = {};
      (alignProfile.nodes || []).forEach(function (node) {
        oldByName[String(node.name)] = node;
      });
      var newNames = {};
      var kept = 0;
      var added = 0;
      var newNodes = incoming.map(function (node) {
        var copy = JSON.parse(JSON.stringify(node));
        delete copy.status;
        var old = oldByName[String(copy.name)];
        copy.selected = !!(old && old.selected);
        if (old && old.selected) {
          kept += 1;
        }
        if (!old) {
          added += 1;
        }
        newNames[String(copy.name)] = true;
        return copy;
      });
      var removedSelectedNames = (alignProfile.nodes || []).filter(function (node) {
        return node.selected && !newNames[String(node.name)];
      }).map(function (node) {
        return String(node.name);
      });
      var wouldEmpty = newNodes.filter(function (node) { return node.selected; }).length === 0;
      var diff = {
        profile: alignId,
        kept: kept,
        added: added,
        removed_selected: removedSelectedNames.length,
        removed_selected_names: removedSelectedNames,
        would_empty: wouldEmpty
      };
      if (wouldEmpty) {
        writeStdout(JSON.stringify(diff, null, 2));
        $.exit(3);
      }
      alignProfile.nodes = newNodes;
      alignProfile.source.last_updated = new Date().toISOString();
      saveManifest(manifestPath, alignManifest);
      writeStdout(JSON.stringify(diff, null, 2));
      return;
    }

    if (command === 'add-warning') {
      if (argv.length < 3) {
        fail('add-warning requires a message');
      }
      var warnManifest = loadManifest(manifestPath);
      if (!Array.isArray(warnManifest.pending_warnings)) {
        warnManifest.pending_warnings = [];
      }
      warnManifest.pending_warnings.push({
        message: String(argv[2]),
        at: new Date().toISOString()
      });
      saveManifest(manifestPath, warnManifest);
      return;
    }

    if (command === 'clear-warnings') {
      var clearManifest = loadManifest(manifestPath);
      clearManifest.pending_warnings = [];
      saveManifest(manifestPath, clearManifest);
      return;
    }

    if (command === 'clear-relay') {
      if (argv.length < 3) {
        fail('clear-relay requires a profile id');
      }
      var clearManifest2 = loadManifest(manifestPath);
      var clearId = String(argv[2]);
      var clearedCount = 0;
      clearManifest2.profiles.forEach(function (profile) {
        (profile.nodes || []).forEach(function (node) {
          if (String(node.relay_profile || '') === clearId) {
            delete node.relay_profile;
            clearedCount += 1;
          }
        });
      });
      saveManifest(manifestPath, clearManifest2);
      writeStdout(String(clearedCount));
      return;
    }

    if (command === 'import-legacy') {
      if (argv.length < 3) {
        fail('import-legacy requires a config path');
      }
      var report = importLegacyConfig(manifestPath, String(argv[2]));
      writeStdout(JSON.stringify(report, null, 2));
      return;
    }

    fail('unknown command: ' + command);
  } catch (error) {
    fail(error.message || error);
  }
}
