#!/bin/bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESOURCE_DIR="$SCRIPT_DIR"
. "$RESOURCE_DIR/app-proxy-common.sh"

app_name="$(app_proxy_plist_value "$SCRIPT_DIR/../Info.plist" CFBundleName)"
runtime_home="${APP_PROXY_HOME:-$HOME}"
APP_PROXY_CONFIG_FILE="${APP_PROXY_CONFIG_FILE:-$runtime_home/Library/Application Support/App Proxy/$app_name/config.env}"
. "$APP_PROXY_CONFIG_FILE"

APP_PROXY_LOG_DIR="${APP_PROXY_LOG_DIR:-$runtime_home/Library/Logs/App Proxy/$app_name}"
APP_PROXY_STATE_DIR="$APP_PROXY_LOG_DIR/state"
/bin/mkdir -p "$APP_PROXY_STATE_DIR" >/dev/null 2>&1 || true
GUARD_LOG="/dev/null"
if /bin/mkdir -p "$APP_PROXY_LOG_DIR" >/dev/null 2>&1; then
  if : >>"$APP_PROXY_LOG_DIR/guard.log" 2>/dev/null; then
    GUARD_LOG="$APP_PROXY_LOG_DIR/guard.log"
  fi
fi

GUARD_CLONE_HOME="${CLONE_HOME:-}"
PROXY_URL=""
if [[ -n "${PROXY_PORT:-}" ]]; then
  PROXY_URL="${PROXY_SCHEME:-http}://${PROXY_HOST:-127.0.0.1}:$PROXY_PORT"
fi

if [[ -z "$PROXY_URL" ]]; then
  # A direct (unproxied) clone inherits its isolation through the environment;
  # there is no proxy invariant to enforce.
  /bin/echo "No proxy configured; nothing to guard." >>"$GUARD_LOG" 2>/dev/null || true
  exit 0
fi

app_proxy_command_is_proxied() {
  local command_line="$1"
  [[ "$command_line" == *"--proxy-server=$PROXY_URL"* ]] && return 0
  [[ "$command_line" == *"--proxy-server $PROXY_URL"* ]] && return 0
  [[ "$command_line" == *"--proxy-server \"$PROXY_URL\""* ]] && return 0
  [[ "$command_line" == *"--proxy-server '$PROXY_URL'"* ]] && return 0
  return 1
}

app_proxy_process_exists() {
  local pid="$1"
  /bin/kill -0 "$pid" >/dev/null 2>&1
}

app_proxy_process_env_command() {
  # command line including the process environment (same-user processes only)
  /bin/ps -E -p "$1" -o command= 2>/dev/null || true
}

app_proxy_env_has_home() {
  local env_command="$1"
  local home_dir="$2"
  [[ "$env_command" == *"HOME=$home_dir "* || "$env_command" == *"HOME=$home_dir" ]]
}

app_proxy_env_belongs_to_any_clone() {
  local env_command="$1"
  [[ "$env_command" == *"HOME="*"/.app-proxy/"* ]] && return 0
  # legacy clone home layout
  [[ "$env_command" == *"HOME="*"/App Proxy/Clones/"* ]]
}

app_proxy_guard_scan_once() {
  local killed_bare=0
  local pid
  local command_line
  local env_command
  local now
  local stamp
  local last_relaunch
  local suppression_seconds

  while IFS= read -r pid; do
    [[ -z "$pid" ]] && continue
    [[ "$pid" == "$$" ]] && continue

    command_line="$(/bin/ps -p "$pid" -o command= 2>/dev/null || true)"
    [[ -z "$command_line" ]] && continue
    if app_proxy_command_is_proxied "$command_line"; then
      continue
    fi

    env_command="$(app_proxy_process_env_command "$pid")"
    if [[ -n "$GUARD_CLONE_HOME" ]]; then
      # clone guard: only processes running inside THIS clone's home are ours
      if ! app_proxy_env_has_home "$env_command" "$GUARD_CLONE_HOME"; then
        continue
      fi
    else
      # main wrapper guard: clone-owned processes are another guard's business
      if app_proxy_env_belongs_to_any_clone "$env_command"; then
        continue
      fi
    fi

    /bin/kill -TERM "$pid" >/dev/null 2>&1 || true
    /bin/sleep 0.2
    if app_proxy_process_exists "$pid"; then
      /bin/kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
    killed_bare=1
  done < <(/bin/ps -axww -o pid= -o command= | /usr/bin/awk -v needle="$TARGET_EXECUTABLE" 'index($0, needle) {print $1}')

  if [[ "$killed_bare" != "1" ]]; then
    return 0
  fi

  now="$(/bin/date +%s)"
  stamp="$APP_PROXY_STATE_DIR/last-guard-relaunch"
  last_relaunch="0"
  if [[ -f "$stamp" ]]; then
    last_relaunch="$(/bin/cat "$stamp" 2>/dev/null || /bin/echo 0)"
  fi
  case "$last_relaunch" in
    ''|*[!0-9]*) last_relaunch="0" ;;
  esac
  suppression_seconds="${RELAUNCH_SUPPRESSION_SECONDS:-20}"
  case "$suppression_seconds" in
    ''|*[!0-9]*) suppression_seconds="20" ;;
  esac

  if [[ $((now - last_relaunch)) -lt "$suppression_seconds" ]]; then
    /bin/echo "Bare target terminated; relaunch suppressed." >>"$GUARD_LOG" 2>/dev/null || true
    return 0
  fi

  /bin/echo "$now" >"$stamp" 2>/dev/null || true
  "$PROXY_APP_PATH/Contents/MacOS/app-proxy-launcher" >>"$GUARD_LOG" 2>&1 &
}

while true; do
  app_proxy_guard_scan_once
  [[ "${APP_PROXY_GUARD_ONCE:-0}" == "1" ]] && exit 0
  /bin/sleep 2
done
