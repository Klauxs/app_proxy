#!/bin/bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$SCRIPT_DIR/app-proxy-common.sh" ]]; then
  # shadow clones keep runtime files next to the launcher (Resources is a
  # read-only symlink into the original app)
  RESOURCE_DIR="$SCRIPT_DIR"
else
  RESOURCE_DIR="$(cd "$SCRIPT_DIR/../Resources" && pwd)"
fi
. "$RESOURCE_DIR/app-proxy-common.sh"

app_name="$(app_proxy_plist_value "$SCRIPT_DIR/../Info.plist" CFBundleName)"
runtime_home="${APP_PROXY_HOME:-$HOME}"
APP_PROXY_CONFIG_FILE="${APP_PROXY_CONFIG_FILE:-$runtime_home/Library/Application Support/App Proxy/$app_name/config.env}"
. "$APP_PROXY_CONFIG_FILE"

APP_PROXY_LOG_DIR="${APP_PROXY_LOG_DIR:-$runtime_home/Library/Logs/App Proxy/$app_name}"
LAUNCHER_LOG="/dev/null"
if /bin/mkdir -p "$APP_PROXY_LOG_DIR" >/dev/null 2>&1; then
  if : >>"$APP_PROXY_LOG_DIR/launcher.log" 2>/dev/null; then
    LAUNCHER_LOG="$APP_PROXY_LOG_DIR/launcher.log"
  fi
fi

app_proxy_launcher_cmd() {
  # test seam: binaries in APP_PROXY_TEST_BIN_DIR shadow the system ones
  local cmd_name="$1"
  shift
  if [[ -n "${APP_PROXY_TEST_BIN_DIR:-}" && -x "$APP_PROXY_TEST_BIN_DIR/$cmd_name" ]]; then
    "$APP_PROXY_TEST_BIN_DIR/$cmd_name" "$@"
    return
  fi
  "/usr/bin/$cmd_name" "$@"
}

PROXY_URL=""
if [[ -n "${PROXY_PORT:-}" ]]; then
  PROXY_URL="${PROXY_SCHEME:-http}://${PROXY_HOST:-127.0.0.1}:$PROXY_PORT"

  if ! app_proxy_launcher_cmd nc -G 1 -z "${PROXY_HOST:-127.0.0.1}" "$PROXY_PORT" >/dev/null 2>&1; then
    # refuse to launch: starting the app without its proxy would silently
    # leak traffic through the wrong (or no) egress
    /bin/echo "Proxy $PROXY_URL is not listening; refusing to launch $app_name." >>"$LAUNCHER_LOG" 2>/dev/null || true
    alert_text="$app_name cannot start: its proxy port $PROXY_PORT is not listening. Run 'app-proxy doctor' in Terminal to diagnose, then try again."
    alert_text="${alert_text//\\/\\\\}"
    alert_text="${alert_text//\"/\\\"}"
    app_proxy_launcher_cmd osascript -e "display alert \"App Proxy\" message \"$alert_text\" as critical" >/dev/null 2>&1 || true
    exit 1
  fi

  export APP_PROXY_WRAPPER=1
  export HTTP_PROXY="$PROXY_URL"
  export HTTPS_PROXY="$PROXY_URL"
  export ALL_PROXY="$PROXY_URL"
  export http_proxy="$PROXY_URL"
  export https_proxy="$PROXY_URL"
  export all_proxy="$PROXY_URL"
else
  # direct connection: do not inherit ambient proxy environment
  unset HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
fi

if [[ -n "${CLONE_HOME:-}" ]]; then
  /bin/mkdir -p "$CLONE_HOME" >/dev/null 2>&1 || true
  # Keychain Services resolve the login keychain via $HOME, so overriding HOME
  # leaves the clone (and every child process) without a keychain and
  # Chromium/Electron safeStorage pops "Keychain Not Found" on each launch.
  # Bridge the real user's keychains into the clone home; keychain data is not
  # part of the isolation goal. Skip if a real (non-symlink) dir exists there.
  if [[ -n "${HOME:-}" && "$HOME" != "$CLONE_HOME" && -d "$HOME/Library/Keychains" ]]; then
    if [[ ! -e "$CLONE_HOME/Library/Keychains" || -L "$CLONE_HOME/Library/Keychains" ]]; then
      /bin/mkdir -p "$CLONE_HOME/Library" >/dev/null 2>&1 || true
      /bin/ln -sfh "$HOME/Library/Keychains" "$CLONE_HOME/Library/Keychains" 2>/dev/null || true
    fi
    # the keychain search list lives in this plist; without it the login
    # keychain is not in the default search path even when present
    if [[ -f "$HOME/Library/Preferences/com.apple.security.plist" \
          && ( ! -e "$CLONE_HOME/Library/Preferences/com.apple.security.plist" \
               || -L "$CLONE_HOME/Library/Preferences/com.apple.security.plist" ) ]]; then
      /bin/mkdir -p "$CLONE_HOME/Library/Preferences" >/dev/null 2>&1 || true
      /bin/ln -sf "$HOME/Library/Preferences/com.apple.security.plist" \
        "$CLONE_HOME/Library/Preferences/com.apple.security.plist" 2>/dev/null || true
    fi
  fi
  export APP_PROXY_CLONE=1
  export HOME="$CLONE_HOME"
  if [[ -z "${CLONE_USER_DATA_DIR:-}" && -n "${TARGET_APP_PATH:-}" ]]; then
    # clones created before CLONE_USER_DATA_DIR existed: derive it, because
    # Chromium/Electron resolve their profile dir from the real user home
    # (ignoring $HOME) and would otherwise share it with the original app
    target_bundle_name="$(app_proxy_plist_value "$TARGET_APP_PATH/Contents/Info.plist" CFBundleName 2>/dev/null)"
    if [[ -n "$target_bundle_name" ]]; then
      CLONE_USER_DATA_DIR="$CLONE_HOME/Library/Application Support/$target_bundle_name"
    fi
  fi
fi

if [[ "${CLONE_MODE:-}" == "shadow" && -n "${TARGET_SOURCE_EXECUTABLE:-}" && -f "$TARGET_SOURCE_EXECUTABLE" ]]; then
  # self-heal after the original app updates: refresh the whole copied payload
  # (frameworks and executable must stay in matching versions), re-apply the
  # clone identity to Info.plist, and re-sign ad-hoc
  if ! /usr/bin/cmp -s "$TARGET_SOURCE_EXECUTABLE" "${TARGET_EXECUTABLE:-}"; then
    /bin/echo "Original app updated; refreshing shadow clone payload." >>"$LAUNCHER_LOG" 2>/dev/null || true
    source_contents="$(/usr/bin/dirname "$(/usr/bin/dirname "$TARGET_SOURCE_EXECUTABLE")")"
    clone_contents="$(cd "$SCRIPT_DIR/.." && pwd)"
    for entry in "$source_contents"/*; do
      entry_name="$(/usr/bin/basename "$entry")"
      case "$entry_name" in
        Info.plist|MacOS|_CodeSignature|embedded.provisionprofile) continue ;;
      esac
      /bin/rm -rf "${clone_contents:?}/$entry_name"
      /bin/cp -Rc "$entry" "$clone_contents/$entry_name" 2>/dev/null \
        || /bin/cp -R "$entry" "$clone_contents/$entry_name" 2>>"$LAUNCHER_LOG" || true
    done
    for entry in "$source_contents/MacOS"/*; do
      entry_name="$(/usr/bin/basename "$entry")"
      case "$entry_name" in
        app-proxy-launcher|app-proxy-guard|app-proxy-common.sh) continue ;;
      esac
      /bin/rm -rf "${clone_contents:?}/MacOS/$entry_name"
      /bin/cp -Rc "$entry" "$clone_contents/MacOS/$entry_name" 2>/dev/null \
        || /bin/cp -R "$entry" "$clone_contents/MacOS/$entry_name" 2>>"$LAUNCHER_LOG" || true
    done
    /bin/chmod 0755 "$TARGET_EXECUTABLE" 2>/dev/null || true
    clone_plist="$SCRIPT_DIR/../Info.plist"
    source_plist="$source_contents/Info.plist"
    if [[ -f "$source_plist" && -f "$clone_plist" ]]; then
      clone_bundle_id="$(app_proxy_plist_value "$clone_plist" CFBundleIdentifier)"
      clone_display="$(app_proxy_plist_value "$clone_plist" CFBundleName)"
      /bin/cp -f "$source_plist" "$clone_plist.refresh" 2>/dev/null || true
      if [[ -f "$clone_plist.refresh" ]]; then
        /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $clone_bundle_id" "$clone_plist.refresh" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Set :CFBundleName $clone_display" "$clone_plist.refresh" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Set :CFBundleDisplayName $clone_display" "$clone_plist.refresh" 2>/dev/null \
          || /usr/libexec/PlistBuddy -c "Add :CFBundleDisplayName string $clone_display" "$clone_plist.refresh" 2>/dev/null || true
        /usr/libexec/PlistBuddy -c "Set :CFBundleExecutable app-proxy-launcher" "$clone_plist.refresh" 2>/dev/null || true
        /bin/mv -f "$clone_plist.refresh" "$clone_plist" 2>/dev/null || true
      fi
    fi
    /bin/rm -f "$clone_contents/embedded.provisionprofile" 2>/dev/null || true
    for entry in "$clone_contents/MacOS"/*; do
      [[ -f "$entry" && ! -L "$entry" ]] || continue
      [[ "$(/usr/bin/basename "$entry")" == "app-proxy-launcher" ]] && continue
      /usr/bin/codesign --force --sign - "$entry" >>"$LAUNCHER_LOG" 2>&1 || true
    done
    /usr/bin/codesign --force --sign - "$(/usr/bin/dirname "$clone_contents")" >>"$LAUNCHER_LOG" 2>&1 || true
  fi
fi

if [[ "${APP_PROXY_LAUNCHER_SMOKE_TEST:-0}" == "1" ]]; then
  if [[ ! -x "${TARGET_EXECUTABLE:-}" ]]; then
    /bin/echo "target executable is not runnable: ${TARGET_EXECUTABLE:-}" >&2
    exit 1
  fi
  if [[ -n "$PROXY_URL" ]]; then
    if [[ "${HTTP_PROXY:-}" != "$PROXY_URL" || "${HTTPS_PROXY:-}" != "$PROXY_URL" || "${ALL_PROXY:-}" != "$PROXY_URL" ]]; then
      /bin/echo "proxy environment was not applied by launcher" >&2
      exit 1
    fi
  fi
  if [[ -n "${CLONE_HOME:-}" && "$HOME" != "$CLONE_HOME" ]]; then
    /bin/echo "clone HOME isolation was not applied by launcher" >&2
    exit 1
  fi
  /bin/echo "launcher smoke ok: ${PROXY_URL:-no-proxy} -> $TARGET_EXECUTABLE"
  exit 0
fi

launch_args=()
if [[ -n "$PROXY_URL" ]]; then
  launch_args+=("--proxy-server=$PROXY_URL")
fi
if [[ -n "${CLONE_USER_DATA_DIR:-}" ]]; then
  # private Chromium profile: isolates clone data AND its single-instance
  # lock, letting the clone run alongside the original app
  /bin/mkdir -p "$CLONE_USER_DATA_DIR" >/dev/null 2>&1 || true
  launch_args+=("--user-data-dir=$CLONE_USER_DATA_DIR")
fi

"$TARGET_EXECUTABLE" ${launch_args[@]+"${launch_args[@]}"} "$@" >>"$LAUNCHER_LOG" 2>&1 &
exit 0
